# Copy this file to ".env" and paste your OWN Gemini API key below.
# Get a free key at https://aistudio.google.com/apikey
# NEVER share your .env file or commit it to git or paste it in a chat.
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-3.8-flash
PORT=3000

# Optional: only needed for real online deployment (see DEPLOY.md).
# Leave these blank to just use local file storage for testing on your own PC.
SUPABASE_URL=
SUPABASE_KEY=
